# ---------- Copy this file to .env and fill in real values ----------
# Never commit the real .env file to GitHub. Add ".env" to .gitignore.

PORT=4000

# MongoDB Atlas (free tier) connection string
# Get this from: Atlas dashboard -> Connect -> Drivers -> copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cao_learning

# Secret used to sign JWT session tokens - any long random string
JWT_SECRET=change_this_to_a_long_random_string

# Telegram bot (BotFather) - never expose this in frontend code again
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_IDS=8134902662,8541390455,ADMIN3_CHAT_ID

# EmailJS (used server-side now, via their REST API)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_OTP_TEMPLATE_ID=your_emailjs_otp_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Admin accounts - plain values here, the server hashes them on first boot
# Format: username:password,username:password
SEED_ADMIN_ACCOUNTS=admin1:Admin@123,admin2:Admin@456,admin3:ChangeMe!789

# Comma-separated origins allowed to call this API (your hosted frontend URL)
ALLOWED_ORIGINS=http://localhost:5500,https://your-frontend.vercel.app
